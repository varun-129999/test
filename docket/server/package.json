{
  "name": "docket-server",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "docket-stdio": "dist/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "stdio": "node --disable-warning=ExperimentalWarning dist/stdio.js",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
